# Copy to .env locally; never commit .env or private profile/report files.
WECHAT_ADAPTER=mac_ax
WECHAT_PROFILE=.local/wechat-profile.json
# Local opaque account label, NOT a native wxid. Verify the logged-in account yourself.
WECHAT_ACCOUNT_REF=local-account
# JSON array; defaults to empty. Bind aliases in the private profile as well.
WECHAT_ALLOWLIST=[]
SEND_MODE=dry-run
DATA_DIR=.local
POLL_INTERVAL_SECONDS=1
# Model configuration arrives in Phase 2; never put keys in VITE_* variables.

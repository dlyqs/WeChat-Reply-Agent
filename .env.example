# Copy locally; never commit private profiles, keys or .env.
WECHAT_ADAPTER=replica
WECHAT_PROFILE=.local/wechat-profile.json
WECHAT_ACCOUNT_REF=local-account
WECHAT_ALLOWLIST=[]
WECHAT_OCR_ENABLED=true
WECHAT_UIA_GATE_ENABLED=true
SEND_MODE=dry-run
DATA_DIR=.local
POLL_INTERVAL_SECONDS=15
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=128
LLM_MAX_CALLS_PER_TURN=1
REPLY_SHOW_SOURCES=false
COALESCE_WINDOW_MS=1500
QUEUE_MAX_SIZE=100
MIN_SEND_INTERVAL_SECONDS=30
MAX_SENDS_PER_MINUTE=2
MAX_REPLIES_PER_RUN=3

RETENTION_DAYS=30
APP_HOST=127.0.0.1
APP_PORT=8765

# Mac service: see docs/mac-probe.md (explicit accepted degraded profile required)
# WECHAT_ADAPTER=mac_db
# WECHAT_PROFILE=.local/macos/profile.json
# MAX_REPLY_CHARACTERS=500
# MAC_BRIDGE_PATH=.local/macos/bin/wechat-ui
# MAC_VERIFY_TIMEOUT_SECONDS=15
